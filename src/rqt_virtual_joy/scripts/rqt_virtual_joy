#!/usr/bin/env python3
import math
import tkinter as tk
from tkinter import ttk

from geometry_msgs.msg import Twist
import rclpy
from rclpy.node import Node


class JoystickWidget(tk.Canvas):
    def __init__(self, parent, size=300, **kwargs):
        super().__init__(parent, width=size, height=size, bg='white', **kwargs)
        self.size = size
        self.center = size // 2
        self.radius = size // 2 - 10
        self.stick_radius = 28
        self.stick_pos = [self.center, self.center]
        self.x = 0.0
        self.y = 0.0
        self.changed = None
        self.create_oval(10, 10, size - 10, size - 10, outline='gray', width=2, fill='white')
        self._draw_stick()
        self.bind('<B1-Motion>', self._drag)
        self.bind('<ButtonRelease-1>', self._release)

    def _draw_stick(self):
        self.delete('stick')
        x, y = self.stick_pos
        self.create_oval(
            x - self.stick_radius,
            y - self.stick_radius,
            x + self.stick_radius,
            y + self.stick_radius,
            fill='white',
            tags='stick',
        )

    def _drag(self, event):
        delta_x = event.x - self.center
        delta_y = event.y - self.center
        distance = math.hypot(delta_x, delta_y)
        if distance > self.radius:
            delta_x = delta_x / distance * self.radius
            delta_y = delta_y / distance * self.radius
        self.stick_pos = [self.center + delta_x, self.center + delta_y]
        self._update()

    def _release(self, _event):
        self.stick_pos = [self.center, self.center]
        self._update()

    def _update(self):
        self._draw_stick()
        self.x = (self.stick_pos[0] - self.center) / self.radius
        self.y = (self.stick_pos[1] - self.center) / self.radius
        if self.changed:
            self.changed()


class VirtualJoyNode(Node):
    def __init__(self):
        super().__init__('virtual_joy_publisher')
        self.publisher = None

    def select_topic(self, topic):
        if self.publisher is not None:
            self.destroy_publisher(self.publisher)
        self.publisher = self.create_publisher(Twist, topic, 10)

    def publish_velocity(self, linear, angular):
        if self.publisher is None:
            return
        message = Twist()
        message.linear.x = linear
        message.angular.z = angular
        self.publisher.publish(message)


class VirtualJoyApp:
    def __init__(self, root, node):
        self.root = root
        self.node = node
        self.root.title('Virtual Joy Publisher')
        self.root.geometry('480x460')
        self.root.configure(bg='white')
        ttk.Style().configure('TLabel', background='white')
        self.root.columnconfigure(1, weight=1)

        ttk.Label(root, text='Topic:').grid(row=0, column=0, sticky=tk.W)
        self.topic = tk.StringVar(value='/cmd_vel')
        ttk.Entry(root, textvariable=self.topic).grid(row=0, column=1, sticky=(tk.W, tk.E))
        ttk.Label(root, text='Rate (Hz):').grid(row=1, column=0, sticky=tk.W)
        self.rate = tk.IntVar(value=20)
        tk.Spinbox(root, from_=1, to=100, textvariable=self.rate).grid(
            row=1, column=1, sticky=(tk.W, tk.E))
        ttk.Label(root, text='Linear Scale:').grid(row=2, column=0, sticky=tk.W)
        self.linear_scale = tk.DoubleVar(value=1.0)
        tk.Scale(root, from_=0.1, to=2.0, resolution=0.1, orient=tk.HORIZONTAL,
                 variable=self.linear_scale).grid(row=2, column=1, sticky=(tk.W, tk.E))
        ttk.Label(root, text='Angular Scale:').grid(row=3, column=0, sticky=tk.W)
        self.angular_scale = tk.DoubleVar(value=1.0)
        tk.Scale(root, from_=0.1, to=2.0, resolution=0.1, orient=tk.HORIZONTAL,
                 variable=self.angular_scale).grid(row=3, column=1, sticky=(tk.W, tk.E))
        self.enabled = tk.BooleanVar(value=False)
        ttk.Checkbutton(root, text='Publish', variable=self.enabled,
                        command=self._toggle).grid(row=4, column=0, columnspan=2)
        self.joystick = JoystickWidget(root)
        self.joystick.grid(row=5, column=0, columnspan=2)
        self.joystick.changed = self._update_label
        self.position_label = ttk.Label(root, text='Position: (0.00, 0.00)')
        self.position_label.grid(row=6, column=0, columnspan=2)
        self.publish_job = None
        self.root.protocol('WM_DELETE_WINDOW', self.close)
        self.root.after(10, self._spin_ros)

    def _toggle(self):
        if self.enabled.get():
            self.node.select_topic(self.topic.get())
            self._publish()
        else:
            self.node.publish_velocity(0.0, 0.0)
            if self.publish_job:
                self.root.after_cancel(self.publish_job)
                self.publish_job = None

    def _publish(self):
        if not self.enabled.get():
            return
        self.node.publish_velocity(
            -self.joystick.y * self.linear_scale.get(),
            -self.joystick.x * self.angular_scale.get(),
        )
        self.publish_job = self.root.after(max(1, int(1000 / self.rate.get())), self._publish)

    def _update_label(self):
        self.position_label.config(
            text=f'Position: ({self.joystick.x:.2f}, {self.joystick.y:.2f})')

    def _spin_ros(self):
        if rclpy.ok():
            rclpy.spin_once(self.node, timeout_sec=0.0)
            self.root.after(10, self._spin_ros)

    def close(self):
        self.node.publish_velocity(0.0, 0.0)
        self.root.destroy()


def main(args=None):
    rclpy.init(args=args)
    node = VirtualJoyNode()
    root = tk.Tk()
    VirtualJoyApp(root, node)
    try:
        root.mainloop()
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
